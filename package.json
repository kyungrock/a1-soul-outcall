{
  "name": "soul-outcall-site",
  "private": true,
  "description": "서울출장마사지 정적 사이트",
  "scripts": {
    "seo": "node scripts/apply-seo.mjs",
    "blog:manifest": "node scripts/build-blog-manifest.mjs",
    "blog:stub-section": "node scripts/inject-blog-posts-section-stub.mjs",
    "content:seoul-blog": "node scripts/fill-seoul-blog-posts-from-rss.mjs --force",
    "content:seoul-blog:once": "node scripts/fill-seoul-blog-posts-from-rss.mjs",
    "content:seoul-blog:dry": "node scripts/fill-seoul-blog-posts-from-rss.mjs --dry-run --force",
    "content:seoul-blog:ai": "node scripts/fill-seoul-blog-posts-from-rss.mjs --force --openai",
    "content:seoul-seo-blog": "node scripts/inject-seoul-seo-blog-html.mjs",
    "content:seoul-blog-board": "node scripts/build-seoul-blog-board.mjs",
    "blog:strip-auto-lists": "node scripts/strip-auto-blog-lists-from-static-pages.mjs",
    "blog:add-draft": "node scripts/add-blog-draft.mjs",
    "content:draft": "node scripts/fetch-daily-draft.mjs && npm run blog:manifest",
    "content:draft:no-ai": "node scripts/fetch-daily-draft.mjs --no-ai && npm run blog:manifest",
    "content:draft:force": "node scripts/fetch-daily-draft.mjs --force && npm run blog:manifest",
    "content:draft:force:no-ai": "node scripts/fetch-daily-draft.mjs --no-ai --force && npm run blog:manifest",
    "shop:cards": "node scripts/render-static-shop-cards.mjs",
    "shop:sync-seoul-districts": "node scripts/sync-seoul-district-registered-shops-from-index.mjs",
    "shop:layout-seoul-home": "node scripts/apply-home-layout-to-dist-seoul.mjs",
    "shop:promo-seoul-districts": "node scripts/inject-seoul-district-promos.mjs",
    "shop:seoul-wide": "node scripts/rebrand-matched-shops-seoul-wide.mjs",
    "images:outcall": "node scripts/fetch-outcall-images.mjs",
    "region:nav": "node scripts/gen-region-nav-snippet.mjs",
    "region:publish": "node scripts/gen-region-nav-snippet.mjs && npm run seo"
  },
  "dependencies": {
    "rss-parser": "^3.13.0"
  }
}
